# Copy this file to the VM-owned deployment directory as .env and replace placeholders.
APP_DB_NAME=zwei
APP_DB_USER=zwei
APP_DB_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgres://zwei:replace-with-a-strong-password@database:5432/zwei?sslmode=disable

JWT_SECRET=replace-with-a-long-random-secret
GIPHY_API_KEY=
PUSH_SUBSCRIPTION_ENCRYPTION_KEY_V1=replace-with-64-hex-characters
PUSH_SUBSCRIPTION_ENCRYPTION_KEY_V2=
PUSH_SUBSCRIPTION_ENCRYPTION_CURRENT_VERSION=v1
PUSH_SUBSCRIPTION_FINGERPRINT_KEY=replace-with-at-least-64-hex-characters
VAPID_PUBLIC_KEY=replace-with-the-base64url-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-the-base64url-vapid-private-key
VAPID_SUBJECT=mailto:admin@false.tel
MESSAGE_ENCRYPTION_KEY=replace-with-a-long-random-secret
TURN_SHARED_SECRET=replace-with-a-long-random-secret
TURN_EXTERNAL_IP=203.0.113.10
ALLOWED_ORIGINS=https://chat.false.tel,https://kyc.chat.false.tel
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=noreply@false.tel
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
ACTIVATION_URL=https://chat.false.tel/activate
INVITATION_URL=https://chat.false.tel/sign-up
# KYC administrator's public client source IP(s), not the Traefik address.
ADMIN_ALLOWED_IPS=203.0.113.10/32
# Static address of the standalone Traefik container on public-edge; this is
# not the Docker subnet and must match that container's fixed network address.
TRUSTED_PROXY_CIDRS=172.30.0.250/32
