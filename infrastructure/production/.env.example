# Copy this file to /home/usermax/zwei/.env and replace every placeholder.
ACME_EMAIL=admin@false.tel

APP_DB_NAME=zwei
APP_DB_USER=zwei
APP_DB_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgres://zwei:replace-with-a-strong-password@database:5432/zwei?sslmode=disable

JWT_SECRET=replace-with-a-long-random-secret
MESSAGE_ENCRYPTION_KEY=replace-with-a-long-random-secret
ALLOWED_ORIGINS=https://chat.false.tel,https://kyc.chat.false.tel
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=noreply@false.tel
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
ACTIVATION_URL=https://chat.false.tel/activate
INVITATION_URL=https://chat.false.tel/sign-up
# KYC administrator's public client source IP(s), not the Traefik address.
ADMIN_ALLOWED_IPS=203.0.113.10/32
# Static Traefik peer on the private edge network; keep separate from client IPs above.
TRUSTED_PROXY_CIDRS=172.31.0.250/32
KYC_BASIC_AUTH_FILE=/home/usermax/zwei-secrets/kyc.htpasswd
