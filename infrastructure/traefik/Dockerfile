FROM alpine:3.22

RUN apk add --no-cache openssl

CMD ["sh", "-c", "if [ ! -f /certs/local.crt ] || [ ! -f /certs/local.key ] || [ ! -f /certs/local-ca.crt ] || [ ! -f /certs/.v3 ]; then rm -f /certs/local-ca.key /certs/local-ca.crt /certs/local.key /certs/local.crt /certs/local.csr /certs/local-ca.srl; printf '%s\n' '[req]' 'distinguished_name=req_distinguished_name' 'x509_extensions=v3_ca' '[req_distinguished_name]' '[v3_ca]' 'basicConstraints=critical,CA:TRUE,pathlen:1' 'keyUsage=critical,keyCertSign,cRLSign' > /tmp/ca.cnf; openssl req -x509 -nodes -newkey rsa:4096 -days 365 -keyout /certs/local-ca.key -out /certs/local-ca.crt -subj '/CN=Zwei Local CA' -config /tmp/ca.cnf -extensions v3_ca; openssl req -nodes -newkey rsa:2048 -keyout /certs/local.key -out /certs/local.csr -subj '/CN=chat.localhost'; printf '%s\n' '[req]' 'distinguished_name=req_distinguished_name' 'req_extensions=req_ext' '[req_distinguished_name]' '[req_ext]' 'basicConstraints=critical,CA:FALSE' 'keyUsage=critical,digitalSignature,keyEncipherment' 'extendedKeyUsage=serverAuth' 'subjectAltName=DNS:chat.localhost,DNS:auth.localhost,DNS:api.chat.localhost,DNS:ws.chat.localhost,DNS:traefik.localhost,DNS:localhost' > /tmp/local.cnf; openssl x509 -req -in /certs/local.csr -CA /certs/local-ca.crt -CAkey /certs/local-ca.key -CAcreateserial -out /certs/local.crt -days 365 -sha256 -extfile /tmp/local.cnf -extensions req_ext; touch /certs/.v3; rm -f /certs/local.csr /certs/local-ca.srl /tmp/local.cnf /tmp/ca.cnf; fi"]
