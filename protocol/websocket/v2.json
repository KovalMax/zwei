{
  "version": 2,
  "compatibility": {"route": "/ws/v2"},
  "clientEvents": {
    "message.send": ["request_id", "payload.conversation_id", "payload.client_message_id", "payload.body"],
    "typing.start": ["payload.conversation_id"],
    "typing.stop": ["payload.conversation_id"],
    "presence.refresh": [],
    "conversation.read": ["payload.conversation_id", "payload.sequence"],
    "call.start": ["request_id", "payload.conversation_id"],
    "call.accept": ["request_id", "payload.call_id"],
    "call.decline": ["request_id", "payload.call_id"],
    "call.cancel": ["request_id", "payload.call_id"],
    "call.end": ["request_id", "payload.call_id"],
    "call.signal": ["request_id", "payload.call_id", "payload.signal"],
    "call.recover": ["request_id", "payload.call_id"],
    "conversation.reconcile": ["request_id", "payload.conversation_id", "payload.after_sequence"],
    "group.call.discover": ["request_id", "payload.conversation_id"],
    "group.call.start": ["request_id", "payload.conversation_id"],
    "group.call.join": ["request_id", "payload.conversation_id", "payload.room_id", "payload.generation"],
    "group.call.sync": ["request_id", "payload.conversation_id", "payload.room_id", "payload.generation"],
    "group.call.leave": ["request_id", "payload.conversation_id", "payload.room_id", "payload.generation"],
    "group.call.end": ["request_id", "payload.conversation_id", "payload.room_id", "payload.generation"],
    "group.call.presenter.start": ["request_id", "payload.conversation_id", "payload.room_id", "payload.generation"],
    "group.call.presenter.stop": ["request_id", "payload.conversation_id", "payload.room_id", "payload.generation"],
    "group.call.signal": ["request_id", "payload.conversation_id", "payload.room_id", "payload.generation", "payload.target_user_id", "payload.target_device_id", "payload.signal"]
  },
  "clientEventAdditiveFields": {
    "message.send": ["payload.mentions", "payload.content_type"]
  },
  "serverEvents": [
    "message.accepted",
    "message.created",
    "message.rejected",
    "presence.snapshot",
    "presence.changed",
    "typing.started",
    "typing.stopped",
    "conversation.created",
    "conversation.read",
    "conversation.reconciled",
    "group.membership.changed",
    "call.incoming",
    "call.ringing",
    "call.accepted",
    "call.declined",
    "call.ended",
    "call.signal",
    "call.rejected",
    "call.recovered",
    "group.call.started",
    "group.call.participant.joined",
    "group.call.participant.left",
    "group.call.ended",
    "group.call.presenter.start",
    "group.call.presenter.stop",
    "group.call.signal",
    "group.call.synced",
    "group.call.discovered"
  ],
  "serverEventFields": {
    "call.rejected.payload.additiveFields": ["support_ref"],
	"call.accepted": ["payload.call_id", "payload.ice_servers", "payload.ice_servers[].urls", "payload.ice_servers[].username", "payload.ice_servers[].credential"],
	"call.signal": ["payload.call_id", "payload.signal"],
	"call.signal.signal": {"$ref": "#/$defs/callSignal"},
	"call.recovered": ["request_id", "payload.status"],
	"call.recovered.status": ["ringing", "missed"],
	"call.recovered.ringingFields": ["payload.call.call_id", "payload.call.conversation_id", "payload.call.caller_id", "payload.call.status", "payload.call.expires_at"],
	"call.recovered.missed.omittedFields": ["payload.call"],
	"call.start.supportRef": "server-generated UUID; present on direct call state projections and rejected-start payloads when the syntactically valid attempt reaches application handling",
	"call.lifecycle.support_ref": "additive UUID field retained for the ephemeral direct call state's TTL",
	"group.call.start.supportRef": "server-generated UUID; present on group room lifecycle projections and rejected-start payloads when the syntactically valid attempt reaches application handling",
	"group.call.lifecycle.support_ref": "additive UUID field retained for the ephemeral room state's TTL",
    "message.accepted.additiveFields": ["payload.mentions", "payload.content_type"],
    "message.created.additiveFields": ["payload.mentions", "payload.content_type"],
	"conversation.read": ["payload.conversation_id", "payload.user_id", "payload.sequence", "payload.visible_from_sequence"],
    "conversation.reconciled": ["request_id", "payload.conversation_id", "payload.messages", "payload.next_after_sequence", "payload.high_watermark", "payload.has_more", "payload.own_read_sequence", "payload.peer_read_sequence"],
    "conversation.reconciled.additiveFields": ["payload.peer_read_cursors"],
    "group.membership.changed": ["payload.conversation_id", "payload.membership_revision", "payload.deleted"],
    "group.call.started": ["payload.room_id", "payload.conversation_id", "payload.membership_revision", "payload.generation", "payload.state_revision", "payload.status", "payload.expires_at", "payload.participants"],
    "group.call.participant.joined": ["payload.room_id", "payload.conversation_id", "payload.membership_revision", "payload.generation", "payload.state_revision", "payload.status", "payload.expires_at", "payload.participants"],
    "group.call.participant.left": ["payload.room_id", "payload.conversation_id", "payload.membership_revision", "payload.generation", "payload.state_revision", "payload.status", "payload.expires_at", "payload.participants"],
    "group.call.ended": ["payload.room_id", "payload.generation", "payload.state_revision", "payload.status", "payload.support_ref"],
    "group.call.ended.fullRoomFields": ["payload.conversation_id", "payload.membership_revision", "payload.expires_at", "payload.participants"],
    "group.call.ended.membershipProjection.omittedFields": ["payload.conversation_id", "payload.membership_revision", "payload.expires_at", "payload.participants", "payload.presenter", "payload.ice_servers"],
    "group.call.presenter.start": ["payload.room_id", "payload.conversation_id", "payload.membership_revision", "payload.generation", "payload.state_revision", "payload.status", "payload.expires_at", "payload.participants"],
    "group.call.presenter.stop": ["payload.room_id", "payload.conversation_id", "payload.membership_revision", "payload.generation", "payload.state_revision", "payload.status", "payload.expires_at", "payload.participants"],
    "group.call.synced": ["request_id", "payload.room_id", "payload.generation", "payload.status"],
    "group.call.synced.activeFields": ["payload.conversation_id", "payload.membership_revision", "payload.state_revision", "payload.participants", "payload.expires_at", "payload.presenter", "payload.support_ref"],
    "group.call.synced.active.omittedFields": ["payload.ice_servers"],
    "group.call.synced.endedFields": ["payload.room_id", "payload.generation", "payload.status", "payload.support_ref"],
    "group.call.synced.ended.omittedFields": ["payload.conversation_id", "payload.membership_revision", "payload.state_revision", "payload.expires_at", "payload.participants", "payload.presenter", "payload.ice_servers"],
    "group.call.discovered": ["request_id", "payload.conversation_id", "payload.room"],
    "group.call.discovered.room": ["payload.room.room_id", "payload.room.conversation_id", "payload.room.membership_revision", "payload.room.generation", "payload.room.state_revision", "payload.room.status", "payload.room.expires_at", "payload.room.participants"],
    "group.call.discovered.roomNullable": true,
    "group.call.discovered.room.omittedFields": ["payload.room.ice_servers", "payload.room.participants.connection_id"],
    "group.call.signal": ["payload.room_id", "payload.generation", "payload.from_user_id", "payload.from_device_id", "payload.signal"],
    "group.call.signal.signal": {"$ref": "#/$defs/callSignal"}
  },
  "clientEventFieldSchemas": {
    "call.signal.payload.signal": {"$ref": "#/$defs/callSignal"},
    "group.call.signal.payload.signal": {"$ref": "#/$defs/callSignal"},
    "message.send.payload.mentions": {"$ref": "#/$defs/mentions"},
    "message.send.payload.content_type": {"$ref": "#/$defs/messageContentType"}
  },
  "clientEventFieldCompatibility": {
    "message.send.payload.content_type": "v2 accepts omitted, text, or sticker"
  },
  "$defs": {
    "messageContentType": {"enum": ["text", "sticker"]},
    "mentions": {
      "type": "array",
      "maxItems": 16,
      "description": "Mention spans use half-open UTF-16 code-unit offsets into the message body.",
      "items": {
        "type": "object",
        "required": ["user_id", "start", "end"],
        "properties": {
          "user_id": {"type": "string", "format": "uuid"},
          "start": {"type": "integer", "minimum": 0, "maximum": 4095},
          "end": {"type": "integer", "minimum": 1, "maximum": 4096}
        },
        "additionalProperties": false
      }
    },
    "callSignal": {
      "oneOf": [
        {"type": "object", "required": ["type", "sdp"], "properties": {"type": {"const": "offer"}, "sdp": {"type": "string", "minLength": 1}}, "additionalProperties": false},
        {"type": "object", "required": ["type", "sdp"], "properties": {"type": {"const": "answer"}, "sdp": {"type": "string", "minLength": 1}}, "additionalProperties": false},
        {"type": "object", "required": ["type", "candidate"], "properties": {"type": {"const": "candidate"}, "candidate": {"type": "object"}}, "additionalProperties": false},
        {"type": "object", "required": ["type"], "properties": {"type": {"const": "screen-share-started"}}, "additionalProperties": false},
        {"type": "object", "required": ["type"], "properties": {"type": {"const": "screen-share-stopped"}}, "additionalProperties": false}
      ]
    }
  }
}
