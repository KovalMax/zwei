{
  "version": 1,
  "clientEvents": {
    "message.send": ["request_id", "payload.conversation_id", "payload.client_message_id", "payload.body"],
    "typing.start": ["payload.conversation_id"],
    "typing.stop": ["payload.conversation_id"],
    "presence.refresh": [],
    "conversation.read": ["payload.conversation_id", "payload.sequence"],
    "call.start": ["request_id", "payload.conversation_id"],
    "call.accept": ["request_id", "payload.call_id"],
    "call.decline": ["request_id", "payload.call_id"],
    "call.cancel": ["request_id", "payload.call_id"],
    "call.end": ["request_id", "payload.call_id"],
    "call.signal": ["request_id", "payload.call_id", "payload.signal"]
  },
  "clientEventFieldSchemas": {
    "call.signal.payload.signal": {"$ref": "#/$defs/callSignal"}
  },
  "callSignalTypes": ["offer", "answer", "candidate", "screen-share-started", "screen-share-stopped"],
  "serverEvents": [
    "message.accepted",
    "message.created",
    "message.rejected",
    "presence.snapshot",
    "presence.changed",
    "typing.started",
    "typing.stopped",
    "conversation.created",
    "conversation.read",
    "call.incoming",
    "call.ringing",
    "call.accepted",
    "call.declined",
    "call.ended",
    "call.signal",
    "call.rejected"
  ],
  "serverEventFields": {
    "call.accepted": ["payload.call_id", "payload.ice_servers", "payload.ice_servers[].urls", "payload.ice_servers[].username", "payload.ice_servers[].credential"],
    "call.signal": ["payload.call_id", "payload.signal"],
    "call.signal.signal": {"$ref": "#/$defs/callSignal"},
    "conversation.read": ["payload.conversation_id", "payload.user_id", "payload.sequence"],
    "conversation.read.additiveFields": ["payload.visible_from_sequence"]
  },
  "$defs": {
    "callSignal": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "sdp"],
          "properties": {"type": {"const": "offer"}, "sdp": {"type": "string", "minLength": 1}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "sdp"],
          "properties": {"type": {"const": "answer"}, "sdp": {"type": "string", "minLength": 1}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "candidate"],
          "properties": {"type": {"const": "candidate"}, "candidate": {"type": "object"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {"type": {"const": "screen-share-started"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {"type": {"const": "screen-share-stopped"}},
          "additionalProperties": false
        }
      ]
    }
  }
}
