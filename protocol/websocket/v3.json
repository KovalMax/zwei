{
  "version": 3,
  "status": "current",
  "compatibility": {"route": "/ws/v3"},
  "clientEvents": {
    "message.send": ["request_id", "payload.conversation_id", "payload.client_message_id", "payload.body", "payload.content_type"],
    "typing.start": ["payload.conversation_id"],
    "typing.stop": ["payload.conversation_id"],
    "presence.refresh": [],
    "conversation.read": ["payload.conversation_id", "payload.sequence"],
    "call.start": ["request_id", "payload.conversation_id"],
    "call.accept": ["request_id", "payload.call_id"],
    "call.decline": ["request_id", "payload.call_id"],
    "call.cancel": ["request_id", "payload.call_id"],
    "call.end": ["request_id", "payload.call_id"],
    "call.signal": ["request_id", "payload.call_id", "payload.signal"],
    "call.recover": ["request_id", "payload.call_id"],
    "conversation.reconcile": ["request_id", "payload.conversation_id", "payload.after_sequence"],
    "group.call.discover": ["request_id", "payload.conversation_id"],
    "group.call.prepare_start": ["request_id", "payload.conversation_id"],
    "group.call.start": ["request_id", "payload.conversation_id", "payload.attempt_id"],
    "group.call.cancel_start": ["request_id", "payload.conversation_id", "payload.attempt_id"],
    "group.call.join": ["request_id", "payload.conversation_id", "payload.room_id", "payload.generation"],
    "group.call.credentials": ["request_id", "payload.conversation_id", "payload.room_id", "payload.generation"],
    "group.call.sync": ["request_id", "payload.conversation_id", "payload.room_id", "payload.generation", "payload.ownership_status"],
    "group.call.leave": ["request_id", "payload.conversation_id", "payload.room_id", "payload.generation"],
    "group.call.end": ["request_id", "payload.conversation_id", "payload.room_id", "payload.generation"],
    "group.call.presenter.start": ["request_id", "payload.conversation_id", "payload.room_id", "payload.generation"],
    "group.call.presenter.stop": ["request_id", "payload.conversation_id", "payload.room_id", "payload.generation"],
    "group.call.signal": ["request_id", "payload.conversation_id", "payload.room_id", "payload.generation", "payload.target_user_id", "payload.target_device_id", "payload.signal"]
  },
  "clientEventAdditiveFields": {
    "message.send": ["payload.mentions"]
  },
  "serverEvents": [
    "message.accepted",
    "message.created",
    "message.rejected",
    "presence.snapshot",
    "presence.changed",
    "typing.started",
    "typing.stopped",
    "conversation.created",
    "conversation.read",
    "conversation.reconciled",
    "group.membership.changed",
    "call.incoming",
    "call.ringing",
    "call.accepted",
    "call.declined",
    "call.ended",
    "call.signal",
    "call.rejected",
    "call.recovered",
    "group.call.start_prepared",
    "group.call.start_cancelled",
    "group.call.start_accepted",
    "group.call.started",
    "group.call.participant.joined",
    "group.call.participant.left",
    "group.call.ended",
    "group.call.presenter.start",
    "group.call.presenter.stop",
    "group.call.signal",
    "group.call.synced",
    "group.call.credentials",
    "group.call.discovered"
  ],
  "serverEventFields": {
    "call.rejected.payload.additiveFields": ["support_ref"],
	"call.accepted": ["payload.call_id", "payload.ice_servers", "payload.ice_servers[].urls", "payload.ice_servers[].username", "payload.ice_servers[].credential"],
	"call.signal": ["payload.call_id", "payload.signal"],
	"call.signal.signal": {"$ref": "#/$defs/callSignal"},
	"call.recovered": ["request_id", "payload.status"],
	"call.recovered.status": ["ringing", "missed"],
	"call.recovered.ringingFields": ["payload.call.call_id", "payload.call.conversation_id", "payload.call.caller_id", "payload.call.status", "payload.call.expires_at"],
	"call.recovered.missed.omittedFields": ["payload.call"],
	"call.start.supportRef": "server-generated UUID; present on direct call state projections and rejected-start payloads when the syntactically valid attempt reaches application handling",
	"call.lifecycle.support_ref": "additive UUID field retained for the ephemeral direct call state's TTL",
	"group.call.start.supportRef": "server-generated UUID; present on group room lifecycle projections and rejected-start payloads when the syntactically valid attempt reaches application handling",
	"group.call.lifecycle.support_ref": "additive UUID field retained for the ephemeral room state's TTL",
    "message.accepted.additiveFields": ["payload.mentions", "payload.content_type"],
    "message.created.additiveFields": ["payload.mentions", "payload.content_type"],
	"conversation.read": ["payload.conversation_id", "payload.user_id", "payload.sequence", "payload.visible_from_sequence"],
    "conversation.reconciled": ["request_id", "payload.conversation_id", "payload.messages", "payload.next_after_sequence", "payload.high_watermark", "payload.has_more", "payload.own_read_sequence", "payload.peer_read_sequence"],
    "conversation.reconciled.additiveFields": ["payload.peer_read_cursors"],
    "group.membership.changed": ["payload.conversation_id", "payload.membership_revision", "payload.deleted"],
    "group.call.start_prepared": ["request_id", "payload.conversation_id", "payload.attempt_id", "payload.expires_at"],
    "group.call.start_accepted": ["request_id", "payload.conversation_id", "payload.room_id", "payload.generation"],
    "group.call.start_accepted.semantics": "Sent only to the initiating socket after the start commits. Correlate request_id to the pending start; do not clear another attempt in response to group.call.started. No attempt capability is sent to peers.",
    "group.call.start_cancelled": ["request_id", "payload.conversation_id", "payload.attempt_id", "payload.outcome"],
    "group.call.start_cancelled.outcome": ["confirmed", "retired", "unknown"],
    "group.call.start_cancelled.semantics": "Cancellation may be retried from a new connection for the same authenticated user and device using the opaque attempt ID. confirmed means the permit is fenced and no matching live room was found, or its room was already ended; retired means the exact room was retired; unknown must not be treated as proof of absence. Start remains bound to the preparing connection.",
    "group.call.start.attempt": "Server-issued unpredictable attempt ID is a bearer capability: keep it in memory only and never log it. Start is single-use and bound to user, device, connection and conversation; cancellation may use the same user and device on a new socket. Preparation expires after 30 seconds according to Redis time. Missing permits and reservations yield unknown; a matching live reservation can still be retired. Unknown does not prove the attempt was absent.",
    "group.call.started": ["payload.room_id", "payload.conversation_id", "payload.membership_revision", "payload.generation", "payload.state_revision", "payload.status", "payload.expires_at", "payload.ring_expires_at", "payload.participants"],
    "group.call.started.deadlines": "ring_expires_at is the invitation deadline; stop ringing at that deadline without ending the room. expires_at is a bounded room lease deadline, not a guaranteed terminal time; the server can renew it while an owning socket remains connected. A late authorized member may discover and join the room until it ends or expires.",
    "group.call.participant.joined": ["payload.room_id", "payload.conversation_id", "payload.membership_revision", "payload.generation", "payload.state_revision", "payload.status", "payload.expires_at", "payload.participants"],
    "group.call.participant.left": ["payload.room_id", "payload.conversation_id", "payload.membership_revision", "payload.generation", "payload.state_revision", "payload.status", "payload.expires_at", "payload.participants"],
    "group.call.ended": ["payload.room_id", "payload.generation", "payload.state_revision", "payload.status", "payload.support_ref"],
    "group.call.ended.fullRoomFields": ["payload.conversation_id", "payload.membership_revision", "payload.expires_at", "payload.participants"],
    "group.call.ended.membershipProjection.omittedFields": ["payload.conversation_id", "payload.membership_revision", "payload.expires_at", "payload.participants", "payload.presenter", "payload.ice_servers"],
    "group.call.presenter.start": ["payload.room_id", "payload.conversation_id", "payload.membership_revision", "payload.generation", "payload.state_revision", "payload.status", "payload.expires_at", "payload.participants"],
    "group.call.presenter.stop": ["payload.room_id", "payload.conversation_id", "payload.membership_revision", "payload.generation", "payload.state_revision", "payload.status", "payload.expires_at", "payload.participants"],
    "group.call.synced": ["request_id", "payload.room_id", "payload.generation", "payload.status", "payload.ownership_status"],
    "group.call.credentials": ["request_id", "payload.conversation_id", "payload.room_id", "payload.generation", "payload.ice_servers", "payload.ice_expires_at"],
    "group.call.credentials.semantics": "Correlated response is delivered only to the requesting socket that owns an unexpired room reservation and remains an authorized member. ice_expires_at is the actual TURN credential expiry; credentials are never published or logged. Lifecycle events carrying ice_servers also include ice_expires_at.",
    "group.call.synced.ownershipStatus": "The request requires payload.ownership_status: true. The response includes payload.ownership_status: active, participant_absent, owned_elsewhere, or room_unavailable. Only active includes the owned roster, for an unexpired ringing or active room owned by this user, device and socket; all other responses are minimal ended acknowledgements. owned_elsewhere reveals only the authenticated user's reservation.",
    "group.call.synced.activeFields": ["payload.conversation_id", "payload.membership_revision", "payload.state_revision", "payload.participants", "payload.expires_at", "payload.presenter", "payload.support_ref"],
    "group.call.synced.active.omittedFields": ["payload.ice_servers"],
    "group.call.synced.endedFields": ["payload.room_id", "payload.generation", "payload.status", "payload.support_ref"],
    "group.call.synced.ended.omittedFields": ["payload.conversation_id", "payload.membership_revision", "payload.state_revision", "payload.expires_at", "payload.participants", "payload.presenter", "payload.ice_servers"],
    "group.call.discovered": ["request_id", "payload.conversation_id", "payload.room"],
    "group.call.discovered.room": ["payload.room.room_id", "payload.room.conversation_id", "payload.room.membership_revision", "payload.room.generation", "payload.room.state_revision", "payload.room.status", "payload.room.expires_at", "payload.room.participants"],
    "group.call.discovered.roomNullable": true,
    "group.call.discovered.room.omittedFields": ["payload.room.ice_servers", "payload.room.participants.connection_id"],
    "group.call.signal": ["payload.room_id", "payload.generation", "payload.from_user_id", "payload.from_device_id", "payload.signal"],
    "group.call.signal.signal": {"$ref": "#/$defs/groupCallSignal"},
    "group.call.signal.negotiation": "Each offer carries a new opaque non-nil canonical lowercase UUID in signal.negotiation_id. Its answer echoes the same ID. The server validates and forwards it unchanged to the authorized participant socket; it does not track or match offer/answer IDs.",
    "group.call.signal.candidateIdentity": "The candidate must identify an ICE username fragment and at least one media selector. A usernameFragment and candidate-line ufrag, when both present, must match; at most one line ufrag is permitted and either fragment is limited to 256 Unicode characters. These cross-field rules are enforced by the server beyond the JSON Schema. Both selectors, when present, identify the same media section. The browser matches these fields to the installed ICE generation. The server validates shape, bounds and fragment consistency, not the SDP relationship; it forwards unchanged to the authorized socket and never logs or persists it. The whole signal remains limited to 16384 encoded bytes."
  },
  "clientEventFieldSchemas": {
    "group.call.sync.payload.ownership_status": {"type": "boolean", "const": true},
    "call.signal.payload.signal": {"$ref": "#/$defs/callSignal"},
    "group.call.signal.payload.signal": {"$ref": "#/$defs/groupCallSignal"},
    "message.send.payload.mentions": {"$ref": "#/$defs/mentions"},
    "message.send.payload.content_type": {"const": "text"}
  },
  "clientEventFieldCompatibility": {
    "message.send.payload.content_type": "writes require explicit text; historical sticker messages remain readable"
  },
  "$defs": {
    "messageContentType": {"enum": ["text", "sticker"]},
    "mentions": {
      "type": "array",
      "maxItems": 16,
      "description": "Mention spans use half-open UTF-16 code-unit offsets into the message body.",
      "items": {
        "type": "object",
        "required": ["user_id", "start", "end"],
        "properties": {
          "user_id": {"type": "string", "format": "uuid"},
          "start": {"type": "integer", "minimum": 0, "maximum": 4095},
          "end": {"type": "integer", "minimum": 1, "maximum": 4096}
        },
        "additionalProperties": false
      }
    },
    "groupCallSignal": {
      "oneOf": [
        {"type": "object", "required": ["type", "sdp", "negotiation_id"], "properties": {"type": {"enum": ["offer", "answer"]}, "sdp": {"type": "string", "minLength": 1}, "negotiation_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "not": {"const": "00000000-0000-0000-0000-000000000000"}}}, "additionalProperties": false},
        {"type": "object", "required": ["type", "candidate"], "properties": {"type": {"const": "candidate"}, "candidate": {"$ref": "#/$defs/groupIceCandidate"}}, "additionalProperties": false},
        {"type": "object", "required": ["type"], "properties": {"type": {"const": "screen-share-started"}}, "additionalProperties": false},
        {"type": "object", "required": ["type"], "properties": {"type": {"const": "screen-share-stopped"}}, "additionalProperties": false}
      ]
    },
    "groupIceCandidate": {
      "type": "object",
      "required": ["candidate"],
      "properties": {
        "candidate": {"type": "string", "maxLength": 4096, "pattern": "^(?:|[cC][aA][nN][dD][iI][dD][aA][tT][eE]:[^ \\t\\n\\f\\r]+[ \\t\\n\\f\\r]+\\d+[ \\t\\n\\f\\r]+(?:[uU][dD][pP]|[tT][cC][pP])[ \\t\\n\\f\\r]+\\d+[ \\t\\n\\f\\r]+[^ \\t\\n\\f\\r]+[ \\t\\n\\f\\r]+\\d+[ \\t\\n\\f\\r]+[tT][yY][pP][ \\t\\n\\f\\r]+(?:[hH][oO][sS][tT]|[sS][rR][fF][lL][xX]|[pP][rR][fF][lL][xX]|[rR][eE][lL][aA][yY])(?:[ \\t\\n\\f\\r]+[^\\n]*)?)(?![\\d\\D])"},
        "sdpMid": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "sdpMLineIndex": {"type": ["integer", "null"], "minimum": 0, "maximum": 65535},
        "usernameFragment": {"type": ["string", "null"], "minLength": 1, "maxLength": 256, "pattern": "^[^\u0009-\u000d\u0020\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]+(?![\\d\\D])"}
      },
      "additionalProperties": false,
      "allOf": [
        {"anyOf": [{"required": ["sdpMid"], "properties": {"sdpMid": {"type": "string"}}}, {"required": ["sdpMLineIndex"], "properties": {"sdpMLineIndex": {"type": "integer"}}}]},
        {"anyOf": [{"required": ["usernameFragment"], "properties": {"usernameFragment": {"type": "string"}}}, {"properties": {"candidate": {"pattern": "(?:^|[ \\t\\n\\f\\r])ufrag[ \\t\\n\\f\\r]+[^ \\t\\n\\f\\r]+"}}}]}
      ]
    },
    "callSignal": {
      "oneOf": [
        {"type": "object", "required": ["type", "sdp"], "properties": {"type": {"const": "offer"}, "sdp": {"type": "string", "minLength": 1}}, "additionalProperties": false},
        {"type": "object", "required": ["type", "sdp"], "properties": {"type": {"const": "answer"}, "sdp": {"type": "string", "minLength": 1}}, "additionalProperties": false},
        {"type": "object", "required": ["type", "candidate"], "properties": {"type": {"const": "candidate"}, "candidate": {"type": "object"}}, "additionalProperties": false},
        {"type": "object", "required": ["type"], "properties": {"type": {"const": "screen-share-started"}}, "additionalProperties": false},
        {"type": "object", "required": ["type"], "properties": {"type": {"const": "screen-share-stopped"}}, "additionalProperties": false}
      ]
    }
  }
}
